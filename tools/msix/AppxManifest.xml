<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10">
  <Identity Name="AIPlanetRemaster"
            Publisher="CN=kroryan"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>AI Planet Remaster</DisplayName>
    <PublisherDisplayName>kroryan</PublisherDisplayName>
    <Logo>icon.png</Logo>
    <Description>Remaster of ai.planet, the GPL-2.0 ecosystem simulator by Dave Kerr, ported to Godot.</Description>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="AIPlanetRemaster" Executable="AIPlanetRemaster.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="AI Planet Remaster"
                          Description="Ecosystem simulator - Godot remaster of ai.planet"
                          BackgroundColor="#1a2438"
                          Square44x44Logo="icon.png"
                          Square150x150Logo="icon.png" />
    </Application>
  </Applications>
</Package>
