class_name AIPUITheme
## Shared programmatic theme for the remaster UI (dark glass style).


static func build() -> Theme:
	var theme := Theme.new()
	var panel := StyleBoxFlat.new()
	panel.bg_color = Color(0.08, 0.1, 0.16, 0.92)
	panel.border_color = Color(0.35, 0.6, 0.9, 0.7)
	panel.set_border_width_all(1)
	panel.set_corner_radius_all(8)
	panel.set_content_margin_all(10)
	var button := StyleBoxFlat.new()
	button.bg_color = Color(0.14, 0.19, 0.3, 0.95)
	button.border_color = Color(0.3, 0.5, 0.8, 0.6)
	button.set_border_width_all(1)
	button.set_corner_radius_all(6)
	button.set_content_margin_all(8)
	var button_hover := button.duplicate()
	button_hover.bg_color = Color(0.2, 0.3, 0.48, 1.0)
	var button_pressed := button.duplicate()
	button_pressed.bg_color = Color(0.28, 0.55, 0.85, 1.0)
	var button_focus := button.duplicate()
	button_focus.border_color = Color(0.6, 0.85, 1.0, 0.9)
	theme.set_stylebox("panel", "PanelContainer", panel)
	theme.set_stylebox("panel", "Panel", panel)
	theme.set_stylebox("normal", "Button", button)
	theme.set_stylebox("hover", "Button", button_hover)
	theme.set_stylebox("pressed", "Button", button_pressed)
	theme.set_stylebox("focus", "Button", button_focus)
	theme.set_stylebox("normal", "ToolButton", button)
	theme.set_stylebox("hover", "ToolButton", button_hover)
	theme.set_stylebox("pressed", "ToolButton", button_pressed)
	theme.set_color("font_color", "Button", Color(0.92, 0.95, 1.0))
	theme.set_color("font_hover_color", "Button", Color(1, 1, 1))
	theme.set_color("font_color", "Label", Color(0.9, 0.94, 1.0))
	theme.set_color("font_color", "RichTextLabel", Color(0.88, 0.92, 1.0))
	theme.set_color("font_color", "LineEdit", Color(0.95, 0.97, 1.0))
	theme.set_color("font_color", "OptionButton", Color(0.92, 0.95, 1.0))
	theme.set_stylebox("normal", "LineEdit", button)
	theme.set_stylebox("normal", "OptionButton", button)
	theme.set_font_size("font_size", "Button", 15)
	theme.set_font_size("font_size", "Label", 15)
	theme.set_font_size("font_size", "RichTextLabel", 14)
	theme.set_font_size("font_size", "LineEdit", 15)
	theme.set_font_size("font_size", "OptionButton", 15)
	return theme
